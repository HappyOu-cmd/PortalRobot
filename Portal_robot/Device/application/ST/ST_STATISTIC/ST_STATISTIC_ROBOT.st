TYPE ST_STATISTIC_ROBOT :
STRUCT
	tCNC_1      	: TIME; // Среднее время работы в стнке 1
	tCNC_2      	: TIME; // Среднее время работы в стнке 2
	tCNC_3      	: TIME; // Среднее время работы в стнке 3
	tMoveCNC_1 		: TIME; // Среднее время перемещения от магазина к станку 1
	tMoveCNC_2 		: TIME; // Среднее время перемещения от магазина к станку 2
	tMoveCNC_3 		: TIME; // Среднее время перемещения от магазина к станку 3
	tMagazine       : TIME; // Среднее время работы в магазине

	rRobot          : REAL; // Процент загрузки робота
END_STRUCT
END_TYPE
