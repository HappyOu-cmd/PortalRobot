{
  "name": "portal-robot-hmi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 0.0.0.0",
    "dev:live": "concurrently -k -n OPCUA,HMI -c yellow,cyan \"npm:gateway\" \"npm:dev:web\"",
    "gateway": "node gateway/server.mjs",
    "start": "node gateway/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "node-opcua": "^2.175.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.166.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.166.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
